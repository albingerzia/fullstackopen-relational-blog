# Copy to .env and replace BOTH password placeholders with the same password.
# Use a URL-safe password (for example: openssl rand -hex 24).
POSTGRES_PASSWORD=replace_with_random_password
DATABASE_URL=postgres://bloguser:replace_with_random_password@127.0.0.1:5432/blogdb

# Keep the API local by default; set HOST to this machine's Tailscale IPv4
# if devices on your tailnet need access. TESTING=true always binds localhost.
HOST=127.0.0.1
PORT=3001

# Generate a separate random signing secret with: openssl rand -hex 32
SECRET=replace_with_a_random_secret_at_least_32_characters

# Local Docker PostgreSQL does not use TLS.
DATABASE_SSL=false
# For a hosted database, prefer TLS verification with its CA certificate.
# DATABASE_SSL=true
# DATABASE_CA_CERT=/absolute/path/to/ca.pem

# Tests require a separate, disposable database named test_db or ending in _test.
# Do not set TESTING=true on the normal server; it enables POST /api/reset.
TEST_DATABASE_URL=postgres://bloguser:replace_with_random_password@127.0.0.1:5432/blogdb_test
