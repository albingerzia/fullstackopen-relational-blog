{
  "name": "fullstackopen-relational-blog",
  "version": "1.0.0",
  "private": true,
  "description": "Full Stack Open relational databases: Chapters 2–4, exercises 1–27",
  "main": "index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "cli": "node cli.js",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:psql": "docker compose exec db psql -U bloguser -d blogdb",
    "db:seed": "docker compose exec -T db psql -U bloguser -d blogdb -v ON_ERROR_STOP=1 < commands.sql",
    "db:test:create": "docker compose exec -T db psql -U bloguser -d postgres -v ON_ERROR_STOP=1 -c 'CREATE DATABASE blogdb_test;'",
    "test": "TESTING=true node --test --test-concurrency=1",
    "test:integration": "TESTING=true node --test --test-concurrency=1 tests/blogs.test.js",
    "test:config": "node --test tests/config.test.js",
    "start:test": "TESTING=true node index.js",
    "migration:up": "node util/migrate.js",
    "migration:down": "node util/rollback.js",
    "test:migrations": "TESTING=true node --test tests/migrations.test.js"
  },
  "dependencies": {
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.1",
    "sequelize": "6.37.8",
    "umzug": "3.8.3"
  },
  "overrides": {
    "sequelize": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "axios": "1.21.1",
    "wait-on": "9.5.1"
  }
}
